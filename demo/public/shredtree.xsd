<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="https://ijm.github.io/shredtree-xml/shredtree.xsd">
  <xs:annotation>
    <xs:documentation>
      The attributes shredtree adds to every element it returns (prefix st).
      https://github.com/ijm/shredtree-xml
    </xs:documentation>
  </xs:annotation>

  <xs:attribute name="id">
    <xs:annotation>
      <xs:documentation>The node's permanent id: 16 random bytes in lowercase hex. Refs name nodes by it.</xs:documentation>
    </xs:annotation>
    <xs:simpleType>
      <xs:restriction base="xs:string">
        <xs:pattern value="[0-9a-f]{32}"/>
      </xs:restriction>
    </xs:simpleType>
  </xs:attribute>

  <xs:attribute name="integrity">
    <xs:annotation>
      <xs:documentation>The node's current content hash, BLAKE2b-256 in lowercase hex. It covers the node's tag, attributes, text, tail and its children's hashes.</xs:documentation>
    </xs:annotation>
    <xs:simpleType>
      <xs:restriction base="xs:string">
        <xs:pattern value="[0-9a-f]{64}"/>
      </xs:restriction>
    </xs:simpleType>
  </xs:attribute>
</xs:schema>
